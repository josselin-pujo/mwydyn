// mwydyn guest world — draft v0.1 (round 07, 2026-11-08): EFFECT-LIST
// shape. Revises draft v0 (imperative imports) per round 07
// ratification — see work-notes/07.
//
// Freeze rule (spec §5): new capability = new CBOR message type,
// never a WIT change. World version bumps are the compatibility
// mechanism. Draft-grade WIT: shapes are normative, syntax is
// approximate until wit-bindgen says otherwise.

package mwydyn:guest@0.1.0;

// ---------------------------------------------------------------- types

interface types {

  /// Addresses are data (§3.4). Readable form for named actors;
  /// opaque instance ids for unnamed ones (spawner-held handles).
  variant address {
    named(named-address),
    instance(string),
  }

  record named-address {
    context: string,
    name: string,
  }

  /// The delivery unit. Runtime-assigned fields (§2) never ride here —
  /// the host wraps this into the runtime envelope (byzantine posture).
  /// Payload is canonical CBOR (§1), decoded host-side. 1 MiB hard cap.
  record letter {
    kind: string,             // layer-2 schema id, e.g. "mwydyn.timer.arm@1"
    payload: list<u8>,
    cause: option<string>,
    correlation: option<string>,
    authority: list<string>,  // row-cites presented (§3.3)
  }

  /// Content-addressed reference; first-class CBOR type on the wire
  /// (tag 1002, §4). `{ digest, media-type, size }`. The media type
  /// is HASH-BOUND: digest = SHA-256(canonical CBOR of {bytes, type})
  /// — content identity includes type (round 12).
  record blob-ref {
    digest: string,
    media-type: string,
    size: u64,
  }

  record cap-row {
    verb: string,     // namespaced by service (§3.3)
    object: string,   // service-defined grammar
  }

  /// COARSE and stable (round 05). How/why minted is runtime policy.
  variant refuse-reason {
    busy,
    unauthorized,
    unknown-target,
    invalid,
  }

  variant verdict {
    ok,
    refuse(refuse-reason),
  }

  /// Effects declared by `receive`; applied by the runtime, in order,
  /// as ONE atomic commit within the receiving context (§3.5).
  variant effect {
    post(post-effect),
    put(put-effect),
    mint(mint-effect),
    emit(emit-effect),
  }

  record post-effect {
    to: address,
    letter: letter,
  }

  /// The digest is computed by the runtime at VALIDATION time —
  /// content addressing makes `put` a pure function of bytes (§4) —
  /// so a later post-effect in the same list may reference it.
  record put-effect {
    bytes: list<u8>,
    media-type: string,
    ttl-micros: option<u64>,
  }

  /// Attenuation-only, holder-only; subsumption verified at
  /// validation with the service's algebra (§3.3). Journaled for
  /// log-tier actors.
  record mint-effect {
    source: cap-row,
    verb: string,
    object: string,
  }

  /// Telemetry is OUTSIDE the transaction (§3.2): applied best-effort,
  /// regardless of commit or rollback. Correlation stamped by runtime.
  record emit-effect {
    level: level,
    message: string,
    fields: list<field>,
  }

  enum level {
    trace,
    debug,
    info,
    warn,
    error,
  }

  record field {
    key: string,
    value: field-value,
  }

  variant field-value;   // TODO: text | int | float | bool | blob-ref
}

// -------------------------------------------------------------- imports
//
// PURE, repeatable reads only (§3.5). There is no post, no put, no
// mint, no emit import — writing is declaring.

interface reads {
  use types.{blob-ref, cap-row, refuse-reason};

  /// Blob refs are content-addressed: the answer is a function of the
  /// ref. A swept ref is a loud error, never changed data (§4 GC is
  /// reference-aware above the live watermark).
  blob-get: func(r: blob-ref) -> result<list<u8>, refuse-reason>;
  blob-len: func(r: blob-ref) -> result<u64, refuse-reason>;
  blob-get-range: func(r: blob-ref, start: u64, end: u64)
    -> result<list<u8>, refuse-reason>;

  /// The LIVE grant set — introspection/audit, never authority
  /// (A1 CTR-3 lesson).
  caps-list: func() -> list<cap-row>;
}

// -------------------------------------------------------------- exports

interface receiver {
  use types.{address, effect, letter};

  /// Runtime-authored, read-only per-delivery context (§2): what the
  /// runtime MINTED, visible to the guest but never settable — the
  /// byzantine posture as a parameter split. Replies target `from`
  /// (round 09's no-reply-to law). World draft v0.2, round 15.
  record msg-ctx {
    from: address,
  }

  /// A PURE TRANSITION: (instance memory, msg-ctx, letter, blob
  /// reads) → effects. Called ONCE per inbox message, sequentially —
  /// the ABI is the single-cursor invariant made mechanical (§3.2).
  /// No clock, no ambient anything (§6); long compute is
  /// fuel/epoch-bounded.
  ///
  /// Purity is contractual: same memory + same ctx + same letter +
  /// live refs ⇒ same effects. This is what makes replay-testing
  /// vector-shaped and checkpoints trivially atomic (§7.6).
  receive: func(ctx: msg-ctx, letter: letter) -> list<effect>;
}

interface boot {
  /// Delivered before any letter (the __athenaManifest lesson): id,
  /// context, advertised caps, static config. Canonical CBOR; the
  /// spec of its contents is a layer-2 schema.
  init: func(spec: list<u8>);
}

world guest {
  import reads;
  export receiver;
  export boot;
}

// ------------------------------------------------- well-known NAMES
//
// Not verbs, not a service registry (§4): names every context binds.
//
//   ticker — the timer service. Arming = declare a post-effect to
//     ticker with "mwydyn.timer.arm@1" { after: <duration>, reply-to }.
//
//     Clock obliviousness (§6): guests NEVER read a clock; subjective
//     time is the inbox cursor. Arm requests carry DURATIONS
//     (deterministic data), never timestamps. The ticker is the only
//     wall-clock reader — runtime-owned — and its ticks are journaled
//     messages: rewind un-happens them, replay re-fires them from the
//     log watermark. Timeout idiom = race the tick against the
//     expected letter; first message wins.
//
//   Durations are data; timestamps are runtime-assigned audit facts
//   (commitTs) — usable for audit, never for branching [A1:04 §5].
